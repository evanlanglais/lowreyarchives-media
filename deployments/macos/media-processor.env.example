# Media Processor Environment Configuration
# Copy this to /etc/media-processor/media-processor.env and fill in values

# Database connection string
DATABASE_URL=postgres://user:password@db-host:5432/lowreyarchives

# S3/Garage configuration
S3_ENDPOINT=https://garage-media-s3.lowreyarchives.com
S3_REGION=garage
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_INGEST_BUCKET=fa-dmz
S3_INGEST_PATH=ingest
S3_MEDIA_BUCKET=fa-media
S3_ARCHIVE_PATH=archive

# Worker configuration
WORKER_COUNT=4
POLL_INTERVAL_SEC=10
MAX_RETRIES=3

# Video processing (Homebrew paths)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
VIDEO_OUTPUT_FORMAT=mp4
VIDEO_CODEC=libx264
VIDEO_PRESET=medium
VIDEO_CRF=20
AUDIO_CODEC=aac
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080

# Image processing
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=85

# Temp directory
TEMP_DIR=/var/lib/media-processor/processing

# Health check
HEALTH_PORT=8080

# Logging
LOG_LEVEL=info
